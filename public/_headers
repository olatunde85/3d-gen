# Cloudflare Pages / Netlify response headers.
# Character data, textures and media rarely change: let browsers cache them for a day.
/assets/*
  Cache-Control: public, max-age=86400
/media/*
  Cache-Control: public, max-age=86400
# Schemas are read by editors, AI tools and other sites.
/schemas/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
