{
  "name": "3d-gen",
  "version": "0.1.0",
  "description": "Open-source, self-hosted generator for realistic, rigged and animated 3D human characters. Exports GLB, FBX and OBJ.",
  "homepage": "https://ara3dgen.com",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "3d",
    "character-generator",
    "game-development",
    "gamedev",
    "rigging",
    "animation",
    "glb",
    "gltf",
    "fbx",
    "obj",
    "makehuman",
    "three.js",
    "avatar",
    "procedural"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:studio-maps && tsc --noEmit && vite build && tsx scripts/build-docs.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "export": "tsx scripts/export-cli.ts",
    "test": "tsx scripts/selftest.ts",
    "setup-assets": "tsx scripts/setup-assets.ts",
    "build-assets": "tsx scripts/build-assets.ts",
    "test:animations": "tsx scripts/animation-improvement-check.ts",
    "test:boarding": "tsx scripts/boarding-check.ts && tsx scripts/boarding-foot-check.ts",
    "test:armed-riding": "tsx scripts/armed-riding-check.ts",
    "test:vehicles": "tsx scripts/vehicle-check.ts && tsx scripts/vehicle-export-check.ts",
    "test:parcel": "tsx scripts/parcel-check.ts",
    "test:gltf": "tsx scripts/gltf-check.ts",
    "build-mocap": "tsx scripts/build-mocap.ts",
    "build:gown-thumbnails": "tsx scripts/ui-check.ts --gowns",
    "test:ui": "tsx scripts/ui-check.ts",
    "test:studio:vehicles": "tsx scripts/studio-vehicles-check.ts && tsx scripts/passenger-contact-check.ts",
    "test:helicopter": "tsx scripts/helicopter-check.ts && tsx scripts/studio-check.ts --helicopter",
    "test:studio:scenes": "tsx scripts/studio-check.ts --scenes",
    "test:studio:editing": "tsx scripts/studio-timing-check.ts && tsx scripts/studio-check.ts --editing",
    "build:studio-thumbnails": "tsx scripts/studio-check.ts --location-thumbnails",
    "build:studio-maps": "tsx scripts/build-studio-maps.ts",
    "test:studio:spatial": "tsx scripts/build-studio-maps.ts --check && tsx scripts/studio-spatial-check.ts",
    "test:studio:model": "tsx scripts/studio-model-check.ts",
    "test:studio": "tsx scripts/studio-check.ts",
    "build:studio-example-gif": "tsx scripts/build-studio-example-gif.ts",
    "build:studio-effects": "tsx scripts/build-studio-effects.ts",
    "build:studio-music": "tsx scripts/build-studio-music.ts",
    "setup:studio-speech": "tsx scripts/setup-studio-speech.ts",
    "test:character-assist": "tsx scripts/character-assist-check.ts",
    "test:action-props": "tsx scripts/action-props-check.ts && tsx scripts/action-props-export-check.ts",
    "test:fleet": "tsx scripts/fleet-check.ts && tsx scripts/studio-check.ts --fleet",
    "test:aerial": "tsx scripts/aerial-check.ts && tsx scripts/studio-check.ts --aerial"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mediabunny": "^1.65.0",
    "onnxruntime-web": "1.31.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "marked": "^15.0.12",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
